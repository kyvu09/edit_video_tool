    "axios": "^1.6.2",
    "clipboardy": "^5.3.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "form-data": "^4.0.0",
    "googleapis": "^173.0.0",
    "multer": "^2.1.1",
    "openai": "^4.52.0",
    "string-similarity": "^4.0.4",
    "youtube-transcript": "^1.3.1"
  }
}
