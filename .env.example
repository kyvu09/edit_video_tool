
OPENAI_API_KEY=your_openai_api_key_here
PORT=3000
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Image generation model — requires billing enabled on Google Cloud
# Options: gemini-3.1-flash-lite-image | gemini-3.1-flash-image | gemini-2.5-flash-image
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Local Python environment path (auto-resolved if omitted)
PYTHON_PATH=.venv/Scripts/python.exe

# Text-to-Speech (TTS)
# Local TTS (VieNeu & Kokoro) runs 100% offline, requires NO API keys!
VIETTEL_AI_TOKEN=your_viettel_ai_token_here

# Local Whisper model size for offline transcription (used when no OpenAI API key)
# Options (accuracy ↑, speed ↓): tiny | base | small | medium | large-v3
# Recommended for Vietnamese: small or medium
LOCAL_WHISPER_MODEL=small
